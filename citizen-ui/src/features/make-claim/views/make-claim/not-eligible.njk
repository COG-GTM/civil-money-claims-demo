{% extends "make-claim/base.njk" %}
{% set title = "You cannot use this demo for this claim" %}
{% block main %}
<h1 class="govuk-heading-l">{{ title }}</h1>
<p class="govuk-body">This demonstration only supports adults making a claim for a known amount up to £25,000 against one person or business, with both parties in England or Wales.</p>
<p class="govuk-body">For a real dispute, <a class="govuk-link" href="https://www.gov.uk/make-court-claim-for-money">read the official guidance on making a court claim for money</a>. Other ways to make a claim may be available.</p>
<p class="govuk-body"><a class="govuk-link" href="/make-claim/eligibility">Check your answers again</a></p>
{% endblock %}
