{% extends "make-claim/base.njk" %}
{% from "govuk/components/textarea/macro.njk" import govukTextarea %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% set title = "Why are you making this claim?" %}
{% block main %}
<span class="govuk-caption-l">Claim details</span>
<form method="post" novalidate>
  <input type="hidden" name="_csrf" value="{{ csrfToken }}">
  {{ govukTextarea({id: "reason", name: "reason", value: reason, rows: 10,
    label: {text: title, isPageHeading: true, classes: "govuk-label--l"},
    hint: {text: "Explain what happened, what was agreed and why you believe the defendant owes you money. You can enter up to 10,000 characters. You can add dates and evidence in the next tasks."},
    errorMessage: fieldErrors.reason, attributes: {maxlength: "10000"} }) }}
  {{ govukButton({text: "Save changes" if change else "Save and continue"}) }}
</form>
{% endblock %}
